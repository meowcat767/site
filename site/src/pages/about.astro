---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me - meowcat767's Website">


    <div class="content-box">
        <div class="box-header">My Interests</div>
        <div class="box-body">
            <p>I think I'm decent at Project Diva, maybe...</p>
            <p>Not qualified to use Godot or jME.</p>
        </div>

        <div class="box-header">GitHub Stats</div>
        <div class="box-body">
            <a href="https://git.io/streak-stats"><img src="https://github-readme-streak-stats.herokuapp.com?user=meowcat767" alt="GitHub Streak" /></a>
        </div>
    </div>
</BaseLayout>

<style>
	.content-box {
		background-color: #a4c2f4;
		border: 2px solid #5b92f4;
		border-radius: 8px;
		margin-bottom: 15px;
		overflow: hidden;
		box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
	}

	.box-header {
		background: linear-gradient(to bottom, #72a3f7, #3b82f6);
		color: white;
		padding: 5px 10px;
		font-weight: bold;
		text-align: center;
		border-bottom: 2px solid #5b92f4;
		text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
	}

	.box-body {
		padding: 10px;
        color: #1e3c82;
        line-height: 1.5;
	}

    .profile-info p {
        margin: 5px 0;
    }

    .profile-info strong {
        color: #0b1d4a;
    }
</style>
